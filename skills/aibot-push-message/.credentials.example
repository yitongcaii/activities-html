# AgentHub 凭证格式参考（仅示例，脚本不再自动读取此文件）
# 实际使用时通过 CLI 参数显式传入：
#   python scripts/send_message.py markdown --endpoint <端点ID> --token <Token> --sendto <目标> --content "<内容>"

# 端点 ID（即 AgentHub 中创建的机器人端点 ID）
AGENTHUB_ENDPOINT=your-endpoint-id

# 鉴权 Token（端点 Token 或静态 Token）
# 获取方式：https://agenthub.woa.com/#/agent/access/endpoint
AGENTHUB_TOKEN=your-api-token
