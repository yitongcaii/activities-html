# 内网部署环境变量模板（复制为 .env 后填值）
# 说明：docker-compose 自动读取同目录 .env；裸 VM 形态在部署脚本/系统环境注入

# MongoDB 连接。
#   Docker 形态：mongodb://mongo:27017/training-management（compose 内服务名）
#   裸 VM 形态：内网 mongo 地址，或本地 mongodb://127.0.0.1:27017/training-management
MONGO_URI=mongodb://127.0.0.1:27017/training-management

# 服务端口（容器/进程监听，前面 OA 网关反代到此端口）
PORT=8080

# 部署后的内网访问地址（前端 AI 助手资源 URL 拼接必须，务必设为真实内网域名）
BASE_URL=https://your-domain.oa.com

# 混元 API Key（AI 助手：主题相似检测/简介优化/知识萃取/反馈分析）。
#   内网不可达或留空 → AI 功能优雅降级，不影响日历/提交/海报/拉群核心功能。
HUNYUAN_API_KEY=
