# AI 服务配置
# 混元 API Key（用于后端 AI 功能：主题相似检测、简介优化、知识萃取、反馈分析等）
# 申请方式：腾讯云控制台 → 模型广场 → 领取免费额度 → 创建 API Key
HUNYUAN_API_KEY=your_hunyuan_api_key_here

# MongoDB 连接（默认本地实例，如使用远程 MongoDB 请修改）
MONGO_URI=mongodb://127.0.0.1:27017/training-management

# 服务端口
PORT=8080

# 部署后的访问地址（用于资源URL拼接，必须是内网域名以支持前端AI助手）
BASE_URL=https://your-domain.woa.com
