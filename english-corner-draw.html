<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>English Corner · Give it a whirl</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<style>
@font-face{font-family:'Bagel Fat One';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
</style>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700&family=Caveat:wght@700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#F8EFD6;
    --cream-light:#FBF4E4;
    --lavender:#8FA0D6;
    --lavender-dark:#6B7DBF;
    --ink:#3A4A6A;
    --ink-dark:#243056;
    --peach:#E8A87C;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    font-family:"DM Sans","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    color:var(--ink);
    background:var(--cream);
    min-height:100vh;
    overflow-x:hidden;
    position:relative;
  }
  /* paper grain texture */
  body::before{
    content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='260'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.35  0 0 0 0 0.28  0 0 0 0 0.2  0 0 0 0.38 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    opacity:.28;mix-blend-mode:multiply;
  }

  .wrap{position:relative;z-index:2;max-width:720px;margin:0 auto;padding:34px 22px 46px}

  /* title — retro outlined display */
  .title{
    font-family:"Bagel Fat One",cursive;
    font-size:clamp(38px,8.2vw,76px);
    line-height:.98;
    text-align:center;
    color:var(--cream-light);
    -webkit-text-stroke:3.5px var(--ink);
    text-shadow:5px 5px 0 var(--lavender);
    letter-spacing:1px;
    margin-top:6px;
  }
  .title span{display:inline-block;transform-origin:bottom center}
  .card:nth-child(1){--tilt:-13deg}
  .card:nth-child(2){--tilt:11deg}
  .card:nth-child(3){--tilt:-9deg}
  .card:nth-child(4){--tilt:14deg}
  .card:nth-child(5){--tilt:-12deg}
  .card:nth-child(6){--tilt:9deg}
  /* 玩法飘带（标题下） */
  .rule{
    display:block;width:fit-content;margin:18px auto 6px;
    padding:11px 26px;
    background:var(--cream-light);
    border:3px solid var(--ink);
    border-radius:40px;
    box-shadow:4px 4px 0 var(--lavender);
    font-family:"Bagel Fat One",cursive;
    font-size:clamp(15px,3.4vw,22px);
    line-height:1.28;
    color:var(--ink);
    letter-spacing:.4px;
    text-align:center;
  }

  /* grid */
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:28px}
  .card{
    position:relative;
    aspect-ratio:4/5;
    cursor:pointer;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    overflow:visible;
    transition:transform .2s ease;
  }
  .card:hover{transform:translateY(-3px) scale(1.03)}
  .card .emoji{
    font-size:clamp(78px,12vw,128px);
    line-height:1;
    transform:translateY(-45px) rotate(var(--tilt,0deg));
    filter:
      brightness(0)
      drop-shadow(4px 0 0 var(--lavender))
      drop-shadow(-4px 0 0 var(--lavender))
      drop-shadow(0 4px 0 var(--lavender))
      drop-shadow(0 -4px 0 var(--lavender));
    transition:filter .6s ease, transform .6s cubic-bezier(.2,1.4,.4,1);
    user-select:none;
    will-change:filter,transform;
  }
  .card .emoji-img{
    width:auto;height:64%;max-width:92%;object-fit:contain;
    transform:translateY(-45px);
    filter:brightness(0)
      drop-shadow(4px 0 0 var(--lavender))
      drop-shadow(-4px 0 0 var(--lavender))
      drop-shadow(0 4px 0 var(--lavender))
      drop-shadow(0 -4px 0 var(--lavender));
    transition:filter .6s ease, transform .6s cubic-bezier(.2,1.4,.4,1);
    user-select:none;
  }
  .card.revealed .emoji-img{filter:drop-shadow(0 4px 8px rgba(58,74,106,.22));transform:translateY(-45px) rotate(var(--tilt,0deg)) scale(1.08)}

  .card .hint, .card .name{
    position:absolute;bottom:55px;left:4px;right:4px;text-align:center;
    font-family:"Bagel Fat One",cursive;
    color:var(--cream-light);
    -webkit-text-stroke:1px var(--ink-dark);
    text-shadow:1px 1px 0 var(--ink-dark);
    transition:opacity .3s ease, transform .4s ease;
    pointer-events:none;
  }
  .card .hint{font-size:35px;letter-spacing:1px;line-height:1}
  .card .name{font-size:35px;letter-spacing:1px}
  .card .name{opacity:0;transform:translateY(8px);transition:opacity .4s ease .15s, transform .4s ease .15s}
  .card.revealed{cursor:default}
  .card.revealed .emoji{filter:drop-shadow(0 4px 8px rgba(58,74,106,.22));transform:translateY(-45px) rotate(var(--tilt,0deg)) scale(1.08)}
  .card.revealed .hint{opacity:0}
  .card.revealed .name{opacity:1;transform:translateY(0)}
  /* 第二排（卡片 4–6）：剪影与序号整体再上移（本次 +15px，累计 -59px） */
  .card:nth-child(n+4) .emoji,
  .card:nth-child(n+4) .emoji-img{transform:translateY(-99px) rotate(var(--tilt,0deg))}
  .card:nth-child(n+4) .hint,
  .card:nth-child(n+4) .name{bottom:109px}
  .card.revealed:nth-child(n+4) .emoji,
  .card.revealed:nth-child(n+4) .emoji-img{transform:translateY(-99px) rotate(var(--tilt,0deg)) scale(1.08)}
  .card.revealed::after{
    content:"";position:absolute;inset:0;border-radius:4px;
    background:radial-gradient(circle at 50% 45%,rgba(255,255,255,.55),transparent 65%);
    opacity:0;animation:shine 1.1s ease forwards;pointer-events:none;
  }
  @keyframes shine{0%{opacity:.85}100%{opacity:0}}
  .card.pop{animation:pop .5s cubic-bezier(.18,1.6,.4,1)}
  @keyframes pop{0%{transform:scale(.92)}55%{transform:scale(1.06)}100%{transform:scale(1)}}

  .confetti{position:fixed;top:0;left:0;width:8px;height:12px;z-index:99;pointer-events:none;border-radius:2px}

  @media (max-width:520px){
    .grid{grid-template-columns:repeat(2,1fr);gap:14px}
  }
</style>
</head>
<body>
  <div class="wrap">
    <h1 class="title"><span style="font-size:1.25em;transform:rotate(-3deg)">E</span><span style="font-size:.95em">n</span><span style="font-size:1.1em">g</span><span style="font-size:.9em">l</span><span style="font-size:1.3em;transform:rotate(3deg)">i</span><span style="font-size:.98em">s</span><span style="font-size:1.05em">h</span> <span style="font-size:1.25em;transform:rotate(-3deg)">C</span><span style="font-size:.95em">o</span><span style="font-size:1.12em">r</span><span style="font-size:.96em">n</span><span style="font-size:1.02em">e</span><span style="font-size:.92em">r</span><br><span style="font-size:1.3em;transform:rotate(3deg)">G</span><span style="font-size:.96em">i</span><span style="font-size:1.12em">v</span><span style="font-size:.98em">e</span> <span style="font-size:1.3em;transform:rotate(-3deg)">i</span><span style="font-size:.9em">t</span> <span style="font-size:1.2em;transform:rotate(-4deg)">a</span> <span style="font-size:1.06em">w</span><span style="font-size:.95em">h</span><span style="font-size:1.1em">i</span><span style="font-size:1.25em;transform:rotate(4deg)">r</span><span style="font-size:.96em">l</span></h1>

    <div class="rule">Pick a number, flip the card,<br>chat about the topic you get!</div>

    <div class="grid" id="grid"></div>
  </div>

<script>
  // 奖品池（参考截图的烘焙组合风格，可改成你们真实奖品）
  const PRIZES = [
    {emoji:"🎓", name:"Graduation"},
    {emoji:"🤯", name:"Mind Blown"},
    {emoji:"📽️", name:"Movie"},
    {emoji:"☎️", name:"Ring Ring"},
    {emoji:"🏝️", name:"Beach"},
    {img:true, src:"data:image/png;base64,", name:"Alan"},
  ];

  const grid = document.getElementById('grid');
  const countEl = document.getElementById('count');
  const totalEl = document.getElementById('total');
  if(totalEl) totalEl.textContent = PRIZES.length;

  function makeCard(p, i){
    const card = document.createElement('div');
    card.className = 'card';
    const fig = p.img
      ? `<img class="emoji-img" src="${p.src}" alt="">`
      : `<div class="emoji">${p.emoji}</div>`;
    card.innerHTML = `
      ${fig}
      <div class="hint">${i + 1}</div>
      <div class="name">${p.name}</div>`;
    card.addEventListener('click', () => reveal(card));
    return card;
  }

  function reveal(card){
    if(card.classList.contains('revealed')) return;
    card.classList.add('revealed','pop');
    burst(card);
    updateCount();
  }

  function updateCount(){
    if(countEl) countEl.textContent = grid.querySelectorAll('.revealed').length;
  }

  function burst(card){
    const r = card.getBoundingClientRect();
    const cx = r.left + r.width/2, cy = r.top + r.height/2;
    const colors = ['#E8A87C','#8FA0D6','#F6EEDA','#3A4A6A','#C38D9E'];
    for(let i=0;i<14;i++){
      const c = document.createElement('div');
      c.className = 'confetti';
      c.style.background = colors[i % colors.length];
      c.style.left = cx + 'px'; c.style.top = cy + 'px';
      document.body.appendChild(c);
      const ang = Math.random()*Math.PI*2;
      const dist = 50 + Math.random()*80;
      const dx = Math.cos(ang)*dist, dy = Math.sin(ang)*dist - 30;
      const rot = (Math.random()*720-360)+'deg';
      c.animate([
        {transform:'translate(0,0) rotate(0)',opacity:1},
        {transform:`translate(${dx}px,${dy}px) rotate(${rot})`,opacity:0}
      ],{duration:650+Math.random()*400,easing:'cubic-bezier(.2,.8,.3,1)'})
       .onfinish = () => c.remove();
    }
  }

  function render(){
    grid.innerHTML = '';
    PRIZES.forEach((p, i) => grid.appendChild(makeCard(p, i)));
    updateCount();
  }

  render();
</script>

  <footer style="text-align:center;font-family:'Bagel Fat One',cursive;font-size:13px;color:var(--ink);opacity:.78;margin:46px 0 6px;letter-spacing:1px">📌 本页由 yitong 沉淀整理 · 文化活动知识库</footer>
</body>
</html>
